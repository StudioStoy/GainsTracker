@using GainsTracker.Common
@using GainsTracker.UI.Elements.Icon
@using GainsTracker.UI.Elements.Shared
@using GainsTracker.UI.Elements.Header

@code {
    [Parameter] public string Title { get; set; } = "Workout Name";
    [Parameter] public string PersonalBest { get; set; } = "None yet!";
    [Parameter] public string? Recent { get; set; }
    [Parameter] public EventCallback OnDelete { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }
}

<div class="workout-bar">
    <div class="workout-info" @onclick="OnClick">
        <GtHeader Size="GtSize.Small">@Title</GtHeader>
        <p>PB: @PersonalBest</p>
        @if (Recent is not null)
        {
            <p>Most recent: @Recent</p>
        }
    </div>
    <button class="delete-button" @onclick="OnDelete">
        <GtIcon Size="GtSize.Small" Icon="Mdi.TrashCanOutline"></GtIcon>
    </button>
</div>
