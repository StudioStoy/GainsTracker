@inject IWorkoutService WorkoutService
@inject ICatalogService CatalogService
@inject ModalService ModalService

@attribute [Authorize]

@page "/workouts"
@using GainsTracker.Common
@using GainsTracker.Common.Models.Workouts
@using GainsTracker.Common.Models.Workouts.Measurements
@using GainsTracker.UI.Components.Modals
@using GainsTracker.UI.Elements.Button
@using GainsTracker.UI.Elements.Modal.Infrastructure
@using GainsTracker.UI.Elements.Shared
@using GainsTracker.UI.Elements.Spinner
@using GainsTracker.UI.Pages.Workout.Components
@using GainsTracker.UI.Pages.Workout.Modals
@using GainsTracker.UI.Services.API.Workouts
@using Microsoft.AspNetCore.Authorization
@using GainsTracker.UI.Elements.Header

<PageTitle>Workouts | GainsTracker</PageTitle>

@if (_selectableWorkouts == null || _workouts == null)
{
    <GtSpinner Size="GtSize.Small"></GtSpinner>
    <p>Loading workouts...</p>
}
else
{
    <div class="page-container">
        <div class="gains-tracker-logo">
            <GtHeader Variant="GtVariant.Secondary">Workouts</GtHeader>
        </div>
        <div class="workout-list-container">
            <div class="mobile-workout-list">
                @foreach (var workout in _workouts)
                {
                    <WorkoutBar Title="@workout.Type.ToString()" PersonalBest="@workout.PersonalBest?.ToLongString()"
                                OnDelete="() => HandleDeleteWorkoutConfirmation(workout.Id)"
                                OnClick="() => HandleOpenAddMeasurementModal(workout)"/>
                }
            </div>

            <div class="desktop-workout-list">
                @foreach (var workout in _workouts)
                {
                    {
                        var pb = workout.PersonalBest is null ? null : new PersonalBestDto(workout.Id, workout.Type.ToString(), workout.PersonalBest);
                        <div class="workout-card-wrapper">
                            <WorkoutCard Title="@workout.Type.ToString()" PersonalBest="@pb"
                                         OnDelete="() => HandleDeleteWorkoutConfirmation(workout.Id)"
                                         OnClick="() => HandleOpenAddMeasurementModal(workout)"/>
                        </div>
                    }
                }
            </div>

            <div class="log-button">
                <GtButton OnClick="HandleOpenNewWorkoutModal">Log new workout</GtButton>
            </div>
        </div>
    </div>
}


@code {
    private List<WorkoutTypeDto>? _selectableWorkouts;
    private List<WorkoutDto>? _workouts;

    protected override async Task OnInitializedAsync()
    {
        _selectableWorkouts = await CatalogService.GetAvailableWorkoutTypes();
        _workouts = await WorkoutService.GetUserWorkouts();
    }

    private void HandleDeleteWorkoutConfirmation(Guid id)
    {
        ModalService.Open(new ConfirmModal
        {
            ConfirmationText = "Are you sure you want to delete this workout?",
            SubText = "This will include all connected measurements.",
            OnConfirm = EventCallback.Factory.Create(this, () => DeleteWorkout(id)),
            Icon = Mdi.DeleteForever,
        });
    }

    private async Task DeleteWorkout(Guid id)
    {
        await WorkoutService.RemoveWorkoutById(id);
        _workouts?.RemoveAll(w => w.Id == id);
    }

    private void HandleOpenNewWorkoutModal()
    {
        if (_selectableWorkouts is null || _selectableWorkouts.Count == 0) return;
        ModalService.Open(new CreateNewWorkoutModal
        {
            SelectableWorkouts = _selectableWorkouts,
            OnConfirm = EventCallback.Factory.Create<CreateNewWorkoutDto>(this, CreateNewWorkout),
        });
    }

    private void HandleOpenAddMeasurementModal(WorkoutDto workout)
    {
        ModalService.Open(new LogMeasurementModal
        {
            Workout = workout,
            OnConfirm = EventCallback.Factory.Create<(Guid, CreateMeasurementDto)>(this, AddWorkoutMeasurement),
        });
    }

    private async Task AddWorkoutMeasurement((Guid workoutId, CreateMeasurementDto measurementDto) data)
    {
        var result = await WorkoutService.AddMeasurementToWorkout(data.workoutId, data.measurementDto);
        if (result.IsSuccess)
            _workouts = await WorkoutService.GetUserWorkouts();
    }

    private async Task CreateNewWorkout(CreateNewWorkoutDto data)
    {
        var result = await WorkoutService.CreateNewWorkout(data);
        if (result.IsSuccess)
            _workouts = await WorkoutService.GetUserWorkouts();
    }

}
