@using GainsTracker.Common.Converters
@using GainsTracker.Common.Models.Workouts.Measurements

<div class="pb-item">
    <div class="pb-title">@PersonalBest.WorkoutName</div>

    <div class="pb-value">
        @GetFormattedValue()
    </div>

    <div class="pb-date">
        @PersonalBest.Measurement.TimeOfRecord.ToString("dd/MM/yyyy")
    </div>
</div>

@code {
    [Parameter]
    public PersonalBestDto PersonalBest { get; set; } = null!;

    private string GetFormattedValue()
    {
        return PersonalBest.Measurement switch
        {
            StrengthMeasurementDto strength => $"{strength.Weight}{UnitConverter.GetWeightUnit()}",
            TimeDistanceEnduranceMeasurementDto endurance => $"{endurance.Distance}{UnitConverter.GetLengthUnit(endurance.Distance)} \n {TimeConverter.MillisecondsToTimeString(endurance.Time)}",
            TimeEnduranceMeasurementDto timeEndurance => $"{TimeConverter.MillisecondsToTimeString(timeEndurance.Time)}",
            RepsMeasurementDto reps => $"{reps.Reps} reps",
            GeneralMeasurementDto general => $"{general.General}",
            _ => "N/A",
        };
    }
}