@using GainsTracker.UI.Elements.Shared
@if (Bounce)
{
    <div class="dumbbell-spinner">
        <i class="bouncing mdi mdi-dumbbell @SizeClass"></i>
    </div>
}
else
{
    <div class="dumbbell-spinner">
        <i class="floating mdi mdi-dumbbell @SizeClass"></i>
    </div>
}

@code {
    [Parameter] public GtSize Size { get; set; } = GtSize.Medium;
    [Parameter] public bool Bounce { get; set; }

    private string SizeClass => Size switch
    {
        GtSize.Small => "gt-small",
        GtSize.Medium => "gt-medium",
        GtSize.Large => "gt-large",
        _ => string.Empty,
    };
}
