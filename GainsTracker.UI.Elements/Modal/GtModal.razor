@using GainsTracker.UI.Elements.Button
@using Microsoft.AspNetCore.Components.Forms
@using GainsTracker.UI.Elements.Modal.Infrastructure

@inject ModalService ModalService

<div class="modal-backdrop @(_isClosing ? "modal-closing-backdrop" : "")"
     tabindex="0"
     @onkeydown="HandleOnKeyDown"
     @onclick="HandleCloseModal"
     @ref="_modalBackdrop">
    <div class="modal-content @(_isClosing ? "modal-closing" : "")" @onclick:stopPropagation="true">

        @if (IsFormModal)
        {
            <EditForm Model="FormModel" OnValidSubmit="HandleFormSubmit">
                <div class="modal-body">
                    @ChildContent
                </div>
                <div class="modal-actions">
                    <GtButton ButtonType="@ConfirmButtonType">
                        @ConfirmButtonText
                    </GtButton>
                    <GtButton OnClick="HandleCancel">
                        @CancelButtonText
                    </GtButton>
                </div>
            </EditForm>
        }
        else
        {
            <div class="modal-body">
                @ChildContent
            </div>
            <div class="modal-actions">
                <GtButton ButtonType="@ConfirmButtonType" OnClick="HandleConfirm">
                    @ConfirmButtonText
                </GtButton>
                <GtButton OnClick="HandleCancel">
                    @CancelButtonText
                </GtButton>
            </div>
        }
    </div>
</div>

@code {
    /// <summary>
    /// Automatically set by adding the HTML between the `<GtModal></GtModal>` tags.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Model to be mutated by the form values. 
    /// </summary>
    /// <remarks>
    /// Setting this value will make the modal use an EditForm.
    /// </remarks>
    [Parameter]
    public object? FormModel { get; set; }

    /// <summary>
    /// Callback action when the Confirm button is pressed.
    /// </summary>
    /// <remarks>
    /// Will be invoked with an EditContext parameter when the modal is a form.
    /// </remarks>
    [Parameter]
    public EventCallback OnConfirm { get; set; }
    
    /// <summary>
    /// Callback action when the Cancel button is pressed.
    /// </summary>
    [Parameter]
    public EventCallback OnCancel { get; set; }

    [Parameter] public string ConfirmButtonText { get; set; } = "Confirm";
    [Parameter] public string CancelButtonText { get; set; } = "Cancel";

    private ElementReference _modalBackdrop;
    private bool _isClosing;
    private bool IsFormModal => FormModel != null;
    private string ConfirmButtonType => IsFormModal ? "submit" : "button";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await _modalBackdrop.FocusAsync();
    }

    private async Task HandleConfirm()
    {
        if (!IsFormModal)
            await OnConfirm.InvokeAsync();

        await HandleCloseModal();
    }

    private async Task HandleFormSubmit(EditContext editContext)
    {
        if (IsFormModal)
            await OnConfirm.InvokeAsync(editContext);

        await HandleCloseModal();
    }

    private async Task HandleCancel()
    {
        await OnCancel.InvokeAsync();

        await HandleCloseModal();
    }

    private async Task HandleCloseModal()
    {
        _isClosing = true;
        await Task.Delay(ModalService.ModalAnimationDelay);
        ModalService.CloseLast();
    }

    private async Task HandleOnKeyDown(KeyboardEventArgs keyboardEvent)
    {
        if (keyboardEvent.Key == "Escape")
            await HandleCloseModal();
    }
}
