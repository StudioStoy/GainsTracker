@using GainsTracker.UI.Elements.Button
@inherits GtModalBase

<div class="modal-backdrop @(IsClosing ? "modal-closing-backdrop" : "")"
     tabindex="0"
     @onkeydown="HandleOnKeyDown"
     @onclick="HandleCloseModal"
     @ref="_modalBackdrop">
    <div class="modal-content @(IsClosing ? "modal-closing" : "")" @onclick:stopPropagation="true">
        <div class="modal-body">
            @ChildContent
        </div>
        <div class="modal-footer">
            @FooterContent
        </div>
        <div class="modal-actions">
            @if (ActionContentOverride != null)
            {
                @ActionContentOverride
            }
            else
            {
                <GtButton OnClick="HandleCloseModal">Confirm</GtButton>
                <GtButton OnClick="HandleCloseModal">Cancel</GtButton>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? FooterContent { get; set; }
    [Parameter] public RenderFragment? ActionContentOverride { get; set; }

    private ElementReference _modalBackdrop;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await _modalBackdrop.FocusAsync();
    }

    private async Task HandleOnKeyDown(KeyboardEventArgs keyboardEvent)
    {
        Console.WriteLine(keyboardEvent);
        if (keyboardEvent.Key == "Escape")
            await HandleCloseModal();
    }
}